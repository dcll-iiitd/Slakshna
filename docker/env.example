# Copy to .env (git-ignored) and edit:   cp env.example .env
# Never commit .env: it can hold tokens.

# --- image ---------------------------------------------------------------
# Tag printed by your build (see README). `dev` always points at the latest local build.
SLAKSHNA_IMAGE=slakshna:dev

# --- GPUs (demo: one GPU per node; indices are the HOST's `nvidia-smi` indices) ---
NODE1_GPU=0
NODE2_GPU=1
NODE3_GPU=2
# production (compose.node.yaml): GPU for this machine's single node
GPU_DEVICE=0

# --- resources -------------------------------------------------------------
# Ray / PyTorch shared memory per container. Docker's default (64m) is too small.
SHM_SIZE=16g

# --- training inputs ---------------------------------------------------------
# Directory with the training data; mounted READ-ONLY at /data. The template's
# data.train_path must point inside /data (default: /data/South_Asia.jsonl).
DATASET_DIR=../Bhaskera/dataset
# Training template: config/node_template.yaml (7B model) or
# config/node_template.smoke.yaml (tiny model, quick pipeline check).
NODE_TEMPLATE=./config/node_template.smoke.yaml
# production only: path to YOUR node config (copy config/node.example.toml)
# NODE_CONFIG=./config/node.toml

# --- Hugging Face / experiment tracking --------------------------------------
# Needed only for gated models.
HF_TOKEN=
# 1 = never touch the network for models (cache must be pre-seeded, see README).
HF_HUB_OFFLINE=0
# offline = log to local files only. Set to "online" and fill WANDB_API_KEY to sync.
WANDB_MODE=offline
WANDB_API_KEY=
